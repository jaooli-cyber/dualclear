use core::num::IntDowncast
use core::ptr::{MemBuffer, MemVec}
use dualclear_core::{
    Bid,
    GOLDEN_FINGERPRINT,
    MAX_BIDS_FINGERPRINT,
    MAX_BIDS,
    MAX_VALUES_FINGERPRINT,
    Price,
    TIE_BREAK_FINGERPRINT,
    clear,
}
use std::abi::{DynArray, dyn_array_from, sol}
use std::evm::{Call, Evm, Wei}

#[abi]
pub struct BidInput { pub id: u64, pub price_raw: u256, pub quantity: u64 }

impl Copy for BidInput {}

#[abi]
pub struct FillOutput { pub id: u64, pub quantity: u64 }

impl Copy for FillOutput {}

msg DualClearMsg {
    #[selector = sol("clear(uint64,(uint64,uint256,uint64)[])")]
    Clear { supply: u64, bids: DynArray<BidInput> } -> (u256, u64, u64, DynArray<FillOutput>),
}

pub contract DualClearGate {
    init() {}

    recv DualClearMsg {
        Clear { supply, bids } -> (u256, u64, u64, DynArray<FillOutput>) {
            assert!(bids.len() > 0 && bids.len() <= MAX_BIDS)
            var core_bids = MemVec<Bid>::with_capacity(bids.len())
            var index: usize = 0
            while index < bids.len() {
                let input = bids.get(index)
                core_bids
                    .push(
                        Bid {
                            id: input.id,
                            price: Price::from_raw(input.price_raw),
                            quantity: input.quantity,
                        },
                    )
                index += 1
            }

            let outcome = clear(core_bids, supply)
            var output_fills = MemVec<FillOutput>::with_capacity(outcome.fills.len())
            index = 0
            while index < outcome.fills.len() {
                let fill = outcome.fills[index]
                output_fills.push(FillOutput { id: fill.id, quantity: fill.quantity })
                index += 1
            }
            let encoded_fills = DynArray::from_slice(output_fills.as_slice())
            (outcome.clearing_price_raw, outcome.filled, outcome.fingerprint, encoded_fills)
        }
    }
}

fn push_abi_word(_ bytes: mut MemVec<u8>, _ value: u256) {
    var index: usize = 0
    while index < 32 {
        let shift = ((31 - index) * 8) as u256
        let byte: u8 = ((value >> shift) & 0xff).downcast_unchecked()
        bytes.push(byte)
        index += 1
    }
}

fn golden_v1_calldata() -> MemVec<u8> {
    var calldata = MemVec<u8>::with_capacity(484)
    calldata.push(0x74)
    calldata.push(0xad)
    calldata.push(0x3a)
    calldata.push(0x54)
    let words: [u256; 15] = [7, 0x40, 4, 2, 2000000, 5, 3, 1000000, 7, 9, 3000000, 2, 1, 2000000, 5]
    var index: usize = 0
    while index < words.len() {
        push_abi_word(mut calldata, words[index])
        index += 1
    }
    calldata
}

fn golden_v1_returndata() -> MemVec<u8> {
    let words: [u256; 13] = [2000000, 7, 0xf85927c169cff4f1, 0x80, 4, 9, 2, 1, 3, 2, 2, 3, 0]
    var returndata = MemVec<u8>::with_capacity(416)
    var index: usize = 0
    while index < words.len() {
        push_abi_word(mut returndata, words[index])
        index += 1
    }
    returndata
}

#[test]
fn clear_selector_is_v1() {
    core::assert(
        sol("clear(uint64,(uint64,uint256,uint64)[])") == 0x74ad3a54,
    )
}

#[test]
fn evm_raw_v1_golden_matches_exact_returndata() uses (evm: mut Evm) {
    let gate = evm.create2<DualClearGate>(value: Wei::zero(), args: (), salt: 11)
    let calldata = golden_v1_calldata()
    let expected = golden_v1_returndata()
    var returned = MemBuffer::with_capacity(expected.len())
    let outcome = evm
        .raw_call(
            addr: gate,
            gas: 2000000,
            value: Wei::zero(),
            args: calldata.as_slice(),
            ret: mut returned,
        )
    core::assert(outcome.success())
    core::assert(outcome.returndata_len() == expected.len() as u256)
    let actual = returned.span()
    core::assert(actual.len() == expected.len())
    var index: usize = 0
    while index < expected.len() {
        core::assert(actual[index] == expected[index])
        index += 1
    }
}

#[test]
fn evm_adapter_matches_the_shared_golden() uses (evm: mut Evm) {
    let gate = evm.create2<DualClearGate>(value: Wei::zero(), args: (), salt: 1)
    var core_bids = MemVec<Bid>::with_capacity(4)
    core_bids.push(
            Bid { id: 1, price: Price::from_raw(2000000), quantity: 5 },
        )
    core_bids.push(
            Bid { id: 9, price: Price::from_raw(3000000), quantity: 2 },
        )
    core_bids.push(
            Bid { id: 3, price: Price::from_raw(1000000), quantity: 7 },
        )
    core_bids.push(
            Bid { id: 2, price: Price::from_raw(2000000), quantity: 5 },
        )
    let expected = clear(core_bids, supply: 7)

    let bids = dyn_array_from(
        [
            BidInput { id: 2, price_raw: 2000000, quantity: 5 },
            BidInput { id: 3, price_raw: 1000000, quantity: 7 },
            BidInput { id: 9, price_raw: 3000000, quantity: 2 },
            BidInput { id: 1, price_raw: 2000000, quantity: 5 },
        ],
    )
    let result: (u256, u64, u64, DynArray<FillOutput>) = evm
        .call(
            addr: gate,
            gas: 2000000,
            value: Wei::zero(),
            message: DualClearMsg::Clear { supply: 7, bids },
        )

    core::assert(result.0 == expected.clearing_price_raw)
    core::assert(result.1 == expected.filled)
    core::assert(result.2 == expected.fingerprint)
    core::assert(result.2 == GOLDEN_FINGERPRINT)
    core::assert(result.3.len() == expected.fills.len())
    var index: usize = 0
    while index < expected.fills.len() {
        let actual_fill = result.3.get(index)
        let expected_fill = expected.fills[index]
        core::assert(actual_fill.id == expected_fill.id)
        core::assert(actual_fill.quantity == expected_fill.quantity)
        index += 1
    }

    // Keep an independent golden oracle as well as the direct core comparison.
    core::assert(result.0 == 2000000 && result.1 == 7)
    core::assert(result.3.len() == 4)
    core::assert(result.3.get(0).id == 9 && result.3.get(0).quantity == 2)
    core::assert(result.3.get(1).id == 1 && result.3.get(1).quantity == 3)
    core::assert(result.3.get(2).id == 2 && result.3.get(2).quantity == 2)
    core::assert(result.3.get(3).id == 3 && result.3.get(3).quantity == 0)
}

#[test(should_revert)]
fn evm_handler_precheck_rejects_empty_bids() uses (evm: mut Evm) {
    let gate = evm.create2<DualClearGate>(value: Wei::zero(), args: (), salt: 2)
    let memory_bids = MemVec<BidInput>::new()
    let bids = DynArray::from_slice(memory_bids.as_slice())

    let _result: (u256, u64, u64, DynArray<FillOutput>) = evm
        .call(
            addr: gate,
            gas: 2000000,
            value: Wei::zero(),
            message: DualClearMsg::Clear { supply: 1, bids },
        )
}

#[test(should_revert)]
fn evm_handler_precheck_rejects_seventeen_bids() uses (evm: mut Evm) {
    let gate = evm.create2<DualClearGate>(value: Wei::zero(), args: (), salt: 3)
    var memory_bids = MemVec<BidInput>::with_capacity(MAX_BIDS + 1)
    var index: usize = 0
    while index < MAX_BIDS + 1 {
        let id: u64 = ((index + 1) as u256).downcast_unchecked()
        memory_bids.push(BidInput { id, price_raw: 1000000, quantity: 1 })
        index += 1
    }
    let bids = DynArray::from_slice(memory_bids.as_slice())

    let _result: (u256, u64, u64, DynArray<FillOutput>) = evm
        .call(
            addr: gate,
            gas: 2000000,
            value: Wei::zero(),
            message: DualClearMsg::Clear { supply: 17, bids },
        )
}
#[test]
fn evm_adapter_matches_tie_break_vector() uses (evm: mut Evm) {
    let gate = evm.create2<DualClearGate>(value: Wei::zero(), args: (), salt: 4)
    let bids = dyn_array_from(
        [
            BidInput { id: 8, price_raw: 2000000, quantity: 1 },
            BidInput { id: 4, price_raw: 2000000, quantity: 1 },
        ],
    )
    let result: (u256, u64, u64, DynArray<FillOutput>) = evm
        .call(
            addr: gate,
            gas: 2000000,
            value: Wei::zero(),
            message: DualClearMsg::Clear { supply: 1, bids },
        )

    core::assert(result.0 == 2000000)
    core::assert(result.1 == 1)
    core::assert(result.2 == TIE_BREAK_FINGERPRINT)
    core::assert(result.3.len() == 2)
    core::assert(result.3.get(0).id == 4 && result.3.get(0).quantity == 1)
    core::assert(result.3.get(1).id == 8 && result.3.get(1).quantity == 0)
}

#[test]
fn evm_adapter_matches_max_values_vector() uses (evm: mut Evm) {
    let gate = evm.create2<DualClearGate>(value: Wei::zero(), args: (), salt: 5)
    let max_quantity: u64 = 0xffffffffffffffff
    let max_price: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    let bids = dyn_array_from(
        [BidInput { id: 1, price_raw: max_price, quantity: max_quantity }],
    )
    let result: (u256, u64, u64, DynArray<FillOutput>) = evm
        .call(
            addr: gate,
            gas: 2000000,
            value: Wei::zero(),
            message: DualClearMsg::Clear { supply: max_quantity, bids },
        )

    core::assert(result.0 == max_price)
    core::assert(result.1 == max_quantity)
    core::assert(result.2 == MAX_VALUES_FINGERPRINT)
    core::assert(result.3.len() == 1)
    core::assert(result.3.get(0).id == 1)
    core::assert(result.3.get(0).quantity == max_quantity)
}

#[test(should_revert)]
fn evm_rejects_zero_supply() uses (evm: mut Evm) {
    let gate = evm.create2<DualClearGate>(value: Wei::zero(), args: (), salt: 6)
    let bids = dyn_array_from([BidInput { id: 1, price_raw: 1000000, quantity: 1 }])
    let _result: (u256, u64, u64, DynArray<FillOutput>) = evm
        .call(
            addr: gate,
            gas: 2000000,
            value: Wei::zero(),
            message: DualClearMsg::Clear { supply: 0, bids },
        )
}

