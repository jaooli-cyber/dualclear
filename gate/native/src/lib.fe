use core::num::IntDowncast
use core::ptr::{MemSlice, MemVec}
use dualclear_core::{
    Bid,
    GOLDEN_FINGERPRINT,
    InputError,
    MAX_VALUES_DCG1_LENGTH,
    MAX_VALUES_FINGERPRINT,
    Outcome,
    Price,
    TIE_BREAK_DCG1_LENGTH,
    TIE_BREAK_FINGERPRINT,
    clear_checked,
}
use std::io::{Write, host, write, write_char}
use std::native::{Arg, Args}

const MAX_U64_WORD: u256 = 0xffffffffffffffff
const MAX_U256_WORD: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

enum CliError {
    Usage,
    Number,
}

impl Copy for CliError {}

struct CliRequest { supply: u64, bids: MemVec<Bid> }

pub fn clear_native(_ bids: own MemVec<Bid>, _ supply: u64) -> Result<InputError, Outcome> {
    clear_checked(bids, supply)
}

fn golden_input() -> MemVec<Bid> {
    var bids = MemVec<Bid>::with_capacity(4)
    bids.push(
        Bid { id: 3, price: Price::from_raw(1000000), quantity: 7 },
    )
    bids.push(
        Bid { id: 1, price: Price::from_raw(2000000), quantity: 5 },
    )
    bids.push(
        Bid { id: 2, price: Price::from_raw(2000000), quantity: 5 },
    )
    bids.push(
        Bid { id: 9, price: Price::from_raw(3000000), quantity: 2 },
    )
    bids
}

fn golden_outcome_matches(_ outcome: Outcome) -> bool {
    outcome.clearing_price_raw == 2000000
        && outcome.filled == 7
        && outcome.fingerprint == GOLDEN_FINGERPRINT
        && outcome.fills.len() == 4
        && outcome.fills[0].id == 9
        && outcome.fills[0].quantity == 2
        && outcome.fills[1].id == 1
        && outcome.fills[1].quantity == 3
        && outcome.fills[2].id == 2
        && outcome.fills[2].quantity == 2
        && outcome.fills[3].id == 3
        && outcome.fills[3].quantity == 0
}

fn native_golden_matches() -> bool {
    match clear_native(golden_input(), supply: 7) {
        Result::Ok(outcome) => golden_outcome_matches(outcome),
        Result::Err(_) => false,
    }
}

fn hex_digit(_ nibble: u8) -> i32 {
    let ascii: u8 = if nibble < 10 {
        0x30 + nibble
    } else {
        0x61 + nibble - 10
    }
    ascii as i32
}

fn write_hex_byte(_ byte: u8) uses (w: mut Write) {
    write_char(hex_digit(byte >> 4))
    write_char(hex_digit(byte & 0x0f))
}

fn write_dcg1_hex(_ bytes: MemSlice<u8>) uses (w: mut Write) {
    write("DCG1:")
    var index: usize = 0
    while index < bytes.len() {
        write_hex_byte(bytes[index])
        index += 1
    }
    write_char(10)
}

fn parse_decimal(_ arg: Arg, _ max_digits: usize, _ max_value: u256) -> Result<CliError, u256> {
    let length = arg.len()
    if length == 0 || length > max_digits {
        return Result::Err(CliError::Number)
    }

    var value: u256 = 0
    var index: usize = 0
    while index < length {
        let byte = arg.byte_at(index)
        if byte < 0x30 || byte > 0x39 {
            return Result::Err(CliError::Number)
        }
        let digit = (byte - 0x30) as u256
        if value > (max_value - digit) / 10 {
            return Result::Err(CliError::Number)
        }
        value = value * 10 + digit
        index += 1
    }
    Result::Ok(value)
}

fn parse_u64_arg(_ arg: Arg) -> Result<CliError, u64> {
    match parse_decimal(arg, max_digits: 20, max_value: MAX_U64_WORD) {
        Result::Ok(value) => {
            match value.downcast() {
                Option::Some(number) => Result::Ok(number),
                Option::None => Result::Err(CliError::Number),
            }
        },
        Result::Err(error) => Result::Err(error),
    }
}

fn parse_u256_arg(_ arg: Arg) -> Result<CliError, u256> {
    parse_decimal(arg, max_digits: 78, max_value: MAX_U256_WORD)
}

fn parse_cli(_ args: Args) -> Result<CliError, CliRequest> {
    let length = args.len()
    if length < 5 || length > 50 || (length - 2) % 3 != 0 {
        return Result::Err(CliError::Usage)
    }
    let count = (length - 2) / 3
    if count == 0 || count > 16 {
        return Result::Err(CliError::Usage)
    }

    let supply = match parse_u64_arg(args.get(1)) {
        Result::Ok(value) => value,
        Result::Err(error) => {
            return Result::Err(error)
        },
    }

    var bids = MemVec<Bid>::with_capacity(count)
    var index: usize = 0
    while index < count {
        let base = 2 + index * 3
        let id = match parse_u64_arg(args.get(base)) {
            Result::Ok(value) => value,
            Result::Err(error) => {
                return Result::Err(error)
            },
        }
        let price_raw = match parse_u256_arg(args.get(base + 1)) {
            Result::Ok(value) => value,
            Result::Err(error) => {
                return Result::Err(error)
            },
        }
        let quantity = match parse_u64_arg(args.get(base + 2)) {
            Result::Ok(value) => value,
            Result::Err(error) => {
                return Result::Err(error)
            },
        }
        bids.push(Bid { id, price: Price::from_raw(price_raw), quantity })
        index += 1
    }
    Result::Ok(CliRequest { supply, bids })
}

fn cli_error_code(_ error: CliError) -> i32 {
    match error {
        CliError::Usage => 64,
        CliError::Number => 65,
    }
}

fn emit_outcome(_ outcome: Outcome) -> i32 {
    with (Write = host()) {
        write_dcg1_hex(outcome.canonical_bytes.as_slice())
    }
    0
}

fn run_auction(_ bids: own MemVec<Bid>, _ supply: u64) -> i32 {
    match clear_native(bids, supply) {
        Result::Ok(outcome) => emit_outcome(outcome),
        Result::Err(_) => 66,
    }
}
pub fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 1 { return 64 }
    if argc == 1 {
        return run_auction(golden_input(), supply: 7)
    }

    let args = unsafe {
        Args::new(argc, argv)
    }
    match parse_cli(args) {
        Result::Ok(request) => run_auction(request.bids, request.supply),
        Result::Err(error) => cli_error_code(error),
    }
}

#[test]
fn native_adapter_matches_the_shared_golden() {
    core::assert(native_golden_matches())
}

#[test]
fn native_invalid_input_returns_typed_error() {
    let bids = MemVec<Bid>::new()
    match clear_native(bids, supply: 1) {
        Result::Err(InputError::EmptyBids) => {},
        _ => {
            assert!(false)
        },
    }
}
#[test]
fn native_adapter_matches_tie_break_vector() {
    var bids = MemVec<Bid>::with_capacity(2)
    bids.push(
        Bid { id: 8, price: Price::from_raw(2000000), quantity: 1 },
    )
    bids.push(
        Bid { id: 4, price: Price::from_raw(2000000), quantity: 1 },
    )

    match clear_native(bids, supply: 1) {
        Result::Ok(outcome) => {
            core::assert(outcome.clearing_price_raw == 2000000)
            core::assert(outcome.filled == 1)
            core::assert(outcome.fingerprint == TIE_BREAK_FINGERPRINT)
            core::assert(outcome.canonical_bytes.len() == TIE_BREAK_DCG1_LENGTH)
            core::assert(outcome.fills.len() == 2)
            core::assert(outcome.fills[0].id == 4 && outcome.fills[0].quantity == 1)
            core::assert(outcome.fills[1].id == 8 && outcome.fills[1].quantity == 0)
        },
        Result::Err(_) => {
            assert!(false)
        },
    }
}

#[test]
fn native_adapter_matches_max_values_vector() {
    let max_quantity: u64 = 0xffffffffffffffff
    let max_price: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    var bids = MemVec<Bid>::with_capacity(1)
    bids.push(
        Bid { id: 1, price: Price::from_raw(max_price), quantity: max_quantity },
    )

    match clear_native(bids, supply: max_quantity) {
        Result::Ok(outcome) => {
            core::assert(outcome.clearing_price_raw == max_price)
            core::assert(outcome.filled == max_quantity)
            core::assert(outcome.fingerprint == MAX_VALUES_FINGERPRINT)
            core::assert(outcome.canonical_bytes.len() == MAX_VALUES_DCG1_LENGTH)
            core::assert(outcome.fills.len() == 1)
            core::assert(outcome.fills[0].id == 1)
            core::assert(outcome.fills[0].quantity == max_quantity)
        },
        Result::Err(_) => {
            assert!(false)
        },
    }
}
